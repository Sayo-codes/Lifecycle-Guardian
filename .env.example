# ==========================================
# Lifecycle Guardian - Environment Configuration
# ==========================================

# --- GitLab Configuration ---
GITLAB_URL=https://gitlab.com
GITLAB_PRIVATE_TOKEN=glpat-your-personal-access-token-here
GITLAB_WEBHOOK_SECRET=your-secure-webhook-secret-token

# --- Multi-Agent Orchestrator Settings ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO
DRY_RUN=false

# --- LLM Provider Settings (Used by Agents for Reasoning & Summaries) ---
# Supported: openai, anthropic, google
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- DevSecOps Gates & Agent Toggles ---
ENABLE_SECURITY_AGENT=true
ENABLE_VERIFICATION_AGENT=true
ENABLE_RELEASE_AGENT=true
ENABLE_MONITORING_AGENT=true
ENABLE_GOVERNANCE_AGENT=true

# Security Gate Behavior: 'block' (halt release on high/critical) or 'warn'
SECURITY_GATE_POLICY=block
MAX_ALLOWED_CRITICAL_VULNERABILITIES=0
MAX_ALLOWED_HIGH_VULNERABILITIES=0

# --- Release Configuration ---
DEFAULT_RELEASE_BRANCH=main
AUTO_SEMVER=true
TAG_PREFIX=v

# --- Monitoring & Observability Integrations (Optional) ---
PROMETHEUS_URL=http://localhost:9090
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
DATADOG_API_KEY=

# --- Notifications & Alerts ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
TEAMS_WEBHOOK_URL=
